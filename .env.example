# Neon PostgreSQL. Use the pooled connection string and keep SSL enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# DeepSeek API through the OpenAI-compatible SDK.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Edge TTS
TTS_VOICE=ar-AE-HamdanNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz

# YouTube OAuth files. Never commit these files.
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_CATEGORY_ID=20
# Optional safety pin. Set this locally to the intended channel ID after OAuth verification.
YOUTUBE_EXPECTED_CHANNEL_ID=
# Optional browser-cookies.txt export for yt-dlp (channel-import). Without it,
# downloads fall back to the android client and typically only 360p is
# available; with it, the web client unlocks 720p/1080p sources. Export from
# your logged-in browser (e.g. via the "Get cookies.txt" extension) and point
# this at the file. Do not commit the file.
YOUTUBE_COOKIES_FILE=
# Set true to automatically flip every successful upload to public after the private upload.
YOUTUBE_PUBLIC_AFTER_UPLOAD=false
# Set true to generate natural Arabic titles/descriptions via DeepSeek for new uploads.
YOUTUBE_AI_METADATA=false
# Metadata language: arabic (Gulf Arabic) or english (mixed UAE/international).
YOUTUBE_METADATA_LANGUAGE=arabic
# Highlight-window bounds for produced Shorts (default 15-60s; raise the floor
# for longer clips, e.g. 25-45).
HIGHLIGHT_MIN_SECONDS=15
HIGHLIGHT_MAX_SECONDS=60
# Ban-safety: max automatic uploads per day (processing still runs; uploads defer).
YOUTUBE_MAX_UPLOADS_PER_DAY=4

# Runtime
WORK_DIR=work
MAX_JOB_ATTEMPTS=3
MAX_SHORT_SECONDS=58
ORIGINAL_AUDIO_VOLUME=0.15
LOG_LEVEL=INFO

# Local capture source (Local Capture Source Integration phase).
# Read-only source directory for owned gameplay recordings. Override with
# --path on `robin-engine capture-scan`, or change this default per machine.
CAPTURE_SOURCE_DIR=C:\Users\loyal\Videos\Captures
# Seconds between two size/mtime snapshots used to detect a file still
# being written (e.g. by Xbox Game Bar) before registering it.
CAPTURE_STABILITY_WAIT_SECONDS=2.0
