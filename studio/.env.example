# Environment Configuration for Robin Engine Control Studio

# Base URL for FastAPI backend endpoints (e.g. http://127.0.0.1:8000/api)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Enable client-side demo mode with in-memory simulated jobs.
# MUST equal exact string "true" to enable demo mode.
VITE_DEMO_MODE=true
